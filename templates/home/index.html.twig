{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="min-h-screen relative">
    <!-- Background elements -->
    <div class="fixed inset-0 bg-gradient-to-br from-primary/5 via-base-100 to-secondary/5"></div>
    
    <!-- Grid pattern -->
    <div class="fixed inset-0 opacity-50">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 30px 30px;"></div>
    </div>

    <div class="relative z-10 flex flex-col lg:flex-row lg:mx-auto">
        <!-- Left Sidebar -->
        <div class="w-full lg:w-2/5 p-6 lg:p-8 lg:pl-20 lg:fixed min-h-[600px] h-screen flex items-center">

            <div class="w-full">
                <header class="max-w-3xl mx-auto">
                    <div class="mb-6 relative w-36 h-36 lg:w-48 lg:h-48 mx-auto lg:mx-0">
                        <svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 600 600" class="w-full h-full">
                            <clipPath id="blob-mask">
                                <path id="blob" d="M570,205C596,115,396,33,303,32C210,30,40,108,14,197C-13,287,51,568,144,569C237,570,543,294,570,205C596,115,396,33,303,32" />
                                {# <path id="blob">
                                    <animate
                                        attributeName="d"
                                        dur="10s"
                                        repeatCount="indefinite"
                                        calcMode="linear"
                                        values="M 570 205 C 596 115 396 33 303 32 C 210 30 40 108 14 197 C -13 287 51 568 144 569 C 237 570 543 294 570 205;
                                               M 589 201 C 590 105 386 -3 289 9 C 192 21 10 175 9 271 C 8 367 188 599 284 588 C 381 576 589 297 589 201;
                                               M 583 203 C 560 111 347 -12 257 11 C 166 35 16 253 39 345 C 62 437 304 585 394 562 C 485 538 606 294 583 203;
                                               M 564 267 C 596 173 386 22 297 16 C 208 10 64 135 32 229 C 0 322 15 573 104 579 C 193 586 531 361 564 267;
                                               M 570 205 C 596 115 396 33 303 32 C 210 30 40 108 14 197 C -13 287 51 568 144 569 C 237 570 543 294 570 205"
                                    />
                                </path> #}
                            </clipPath>
                            <image 
                                clip-path="url(#blob-mask)"
                                href="{{ asset(personal_info.files.profile_image) }}"
                                width="100%"
                                height="100%"
                                preserveAspectRatio="xMidYMid slice"
                                loading="lazy"
                                decoding="async"
                            />
                        </svg>
                    </div>
                    <div class="text-center lg:text-left">
                        <h1 class="text-3xl lg:text-4xl font-bold mb-2">{{personal_info.name}}</h1>
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-4 justify-center lg:justify-start flex-col lg:flex-row">
                                <h2 class="text-lg lg:text-xl font-semibold text-gray-300" data-trans="sidebar.job_title">{{ 'sidebar.job_title'|trans }}</h2>
                                {# <div class="flex items-center gap-2 py-1 px-2.5 bg-success/10 text-success rounded-full">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
                                    </span>
                                    <span class="text-xs font-medium" data-trans="sidebar.open_to_job">{{ 'sidebar.open_to_job'|trans }}</span>
                                </div> #}
                            </div>
                            <div class="flex items-center gap-1 text-gray-400 justify-center lg:justify-start">
                                <i class="fa-solid fa-location-dot"></i>
                                <span data-trans="sidebar.location">{{ 'sidebar.location'|trans }}</span>
                            </div>
                            <p class="text-gray-300 text-sm mt-1" data-trans="sidebar.tagline">{{ 'sidebar.tagline'|trans }}</p>
                        </div>
                    </div>

                    <!-- Resume Download and Social Links -->
                    <div class="mt-6 flex items-center gap-4 flex-col lg:flex-row">
                        <div class="group flex-1 w-full">
                            <a href="{{ asset(personal_info.files.cv) }}" download class="relative flex items-center justify-center w-full px-4 py-2 bg-base-200 rounded-lg border border-base-content/10 shadow-sm transition-all duration-300 hover:shadow-md hover:scale-[1.02] overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-secondary/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0"></div>
                                <div class="flex items-center gap-2 relative z-10">
                                    <i class="fa-solid fa-file-arrow-down"></i>
                                    <span class="relative flex items-center text-sm font-medium" data-trans="sidebar.resume">
                                        {{ 'sidebar.resume'|trans }}
                                    </span>
                                </div>
                            </a>
                        </div>
                        <div class="flex gap-4 mt-4 lg:mt-0">
                            <a href="{{ personal_info.social.github }}" alt="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-base-content transition-colors hover:scale-110 transform duration-200">
                                <i class="fa-brands fa-github fa-xl"></i>
                            </a>
                            <a href="mailto:{{ personal_info.social.email }}" alt="Email" title="Email" class="text-gray-300 hover:text-base-content transition-colors hover:scale-110 transform duration-200">
                                <i class="fa-solid fa-envelope fa-xl"></i>
                            </a>
                            <a href="{{ personal_info.social.linkedin }}" alt="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-base-content transition-colors hover:scale-110 transform duration-200">
                                <i class="fa-brands fa-linkedin fa-xl"></i>
                            </a>
                        </div>
                    </div>

                    <div class="mt-6 space-y-3">
                        <div class="grid gap-3">
                            <div class="p-4 rounded-xl bg-gradient-to-br from-primary/10 to-base-300/80 border border-base-content/5">
                                {# <h2 class="text-base font-bold mb-1" data-trans="sidebar.open_to_job">{{ 'sidebar.open_to_job'|trans }}</h2> #}
                                <p class="text-base-content/70 mb-3 text-sm" data-trans="sidebar.open_to_job_description">{{ 'sidebar.open_to_job_description'|trans }}</p>
                                <div class="flex justify-center">
                                    <button 
                                        onclick="contact_modal.showModal()" 
                                        class="w-full px-4 py-2 bg-gradient-to-r from-primary to-secondary text-primary-content rounded-lg font-medium transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 text-sm">
                                        <i class="fa-solid fa-briefcase"></i>
                                        <span class="relative flex items-center text-sm font-medium" data-trans="sidebar.lets_connect">
                                            {{ 'sidebar.lets_connect'|trans }}
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="mt-8">
                    <!-- Contact Modal -->
                    <dialog id="contact_modal" class="modal modal-center">
                        <div class="modal-box bg-base-200/95 border border-base-content/10 relative overflow-hidden">
                            <!-- Decorative background gradient -->
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 pointer-events-none"></div>
                            
                            <div class="relative">
                                <h3 class="font-bold text-3xl mx-auto mt-2 mb-4 w-fit bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent" data-trans="contact_form.title">{{ 'contact_form.title'|trans }}</h3>
                                    
                                    {% for message in app.flashes('success') %}
                                        <div class="alert alert-success mb-4">
                                            <i class="fa-solid fa-check"></i>
                                            <span data-trans="{{ message }}">{{ message|trans }}</span>
                                        </div>
                                    {% endfor %}
                                    
                                    {% for message in app.flashes('error') %}
                                        <div class="alert alert-error mb-4">
                                            <i class="fa-solid fa-circle-exclamation"></i>
                                            <span data-trans="{{ message }}">{{ message|trans }}</span>
                                        </div>
                                    {% endfor %}

                                    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                                        <div class="form-control">
                                            <label class="label">
                                                <span class="label-text font-medium text-base-content/70" data-trans="contact_form.name">{{ 'contact_form.name'|trans }}</span>
                                            </label>
                                            {{ form_widget(form.name) }}
                                            {{ form_errors(form.name) }}
                                        </div>
                                        <div class="form-control">
                                            <label class="label">
                                                <span class="label-text font-medium text-base-content/70" data-trans="contact_form.email">{{ 'contact_form.email'|trans }}</span>
                                            </label>
                                            {{ form_widget(form.email) }}
                                            {{ form_errors(form.email) }}
                                        </div>
                                        <div class="form-control">
                                            <label class="label">
                                                <span class="label-text font-medium text-base-content/70" data-trans="contact_form.message">{{ 'contact_form.message'|trans }}</span>
                                            </label>
                                            {{ form_widget(form.message) }}
                                            {{ form_errors(form.message) }}
                                        </div>
                                        
                                        <!-- Privacy Policy Consent -->
                                        <div class="form-control">
                                            <label class="label cursor-pointer justify-start gap-3">
                                                {{ form_widget(form.consent) }}
                                                <span class="label-text text-sm" data-trans="contact_form.privacy_consent" data-trans-params='{ "%privacy_url%": "{{path('privacy_policy')}}" }' data-trans-raw>
                                                    {{ 'contact_form.privacy_consent'|trans({'%privacy_url%': path('privacy_policy')})|raw }}
                                                </span>
                                            </label>
                                            {{ form_errors(form.consent) }}
                                        </div>

                                        <div class="modal-action">
                                            <button type="submit" class="px-4 py-2 bg-gradient-to-r from-primary to-secondary text-primary-content rounded-lg font-medium transition-all duration-300 hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2" data-trans="contact_form.send">
                                                <i class="fa-solid fa-paper-plane"></i>
                                                {{ 'contact_form.send'|trans }}
                                            </button>
                                            <button type="button" class="btn" onclick="contact_modal.close()" data-trans="contact_form.cancel">{{ 'contact_form.cancel'|trans }}</button>
                                        </div>
                                    {{ form_end(form) }}
                                </div>
                            </div>
                        <form method="dialog" class="modal-backdrop bg-base-200/50">
                            <button>close</button>
                        </form>
                    </dialog>

                </div>

            </div>
        </div>

        <!-- Main Content -->
        <div class="w-full lg:w-3/5 lg:ml-auto p-6 lg:p-12 mt-6 lg:mt-0">
            <!-- About Section -->
            <section id="about" class="max-w-3xl mx-auto lg:mx-0">
                <h2 class="text-3xl lg:text-4xl font-bold mb-6 lg:mb-8" data-trans="sections.about">{{ 'sections.about'|trans }}</h2>
                <div class="space-y-6 text-base-content/80 text-lg text-justify">
                    <p data-trans="about.paragraph1" data-trans-params='{ "%age%": {{age}} }' data-trans-raw>{{ 'about.paragraph1'|trans({'%age%': age})|raw }}</p>
                    <p data-trans="about.paragraph2" data-trans-raw>{{ 'about.paragraph2'|trans|raw }}</p>
                </div>
            </section>

            <!-- Skills Section -->
            {% include 'components/_skills.html.twig' %}

            <!-- Experience/Education Toggle -->
            <div class="max-w-3xl mb-1 mt-12 sm:mt-16 mx-auto sm:mx-0 flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-4">
                <h2 id="section-title" class="text-3xl lg:text-4xl font-bold transition-opacity duration-500 relative overflow-hidden">
                    <span id="section-title-experience" class="inline-block transition-all duration-300" data-trans="sections.experience">{{ 'sections.experience'|trans }}</span>
                    <span id="section-title-education" class="inline-block transition-all duration-300 hidden" data-trans="sections.education">{{ 'sections.education'|trans }}</span>
                </h2>
                <button id="toggle-section-btn" class="lg:ml-4 px-2 py-1 border border-dashed text-base-content/80 hover:text-base-content border-base-content/30 bg-transparent shadow-none rounded-lg transition-all duration-200 hover:border-base-content/50 text-sm font-normal relative overflow-hidden">
                    <i class="fa-solid fa-angle-right mr-1"></i>
                    <span id="toggle-btn-education" class="inline-block transition-all duration-200" data-trans="sections.show_education">
                        {{ 'sections.show_education'|trans }}
                    </span>
                    <span id="toggle-btn-experience" class="inline-block transition-all duration-200 hidden" data-trans="sections.show_experience">
                        {{ 'sections.show_experience'|trans }}
                    </span>
                </button>
            </div>

            <!-- Sections Container -->
            <div id="sections-container" class="relative overflow-hidden max-w-3xl lg:mx-0 mx-auto">
                <section id="experience" class="transition-all duration-500 ease-in-out transform">
                    {% include 'components/_experience.html.twig' %}
                </section>
                <section id="education" class="transition-all duration-500 ease-in-out transform hidden">
                    {% include 'components/_education.html.twig' %}
                </section>
            </div>

            <!-- Projects Section -->
            {% include 'components/_projects.html.twig' %}

            <!-- Footer -->
            <footer class="mx-auto lg:mx-0 max-w-3xl mt-16 pb-8">
                <div class="grid grid-cols-1 sm:[grid-template-columns:1fr_auto_1fr] items-center justify-items-center text-sm text-base-content/50 gap-0">
                    <a href="{{ path('legal_notice') }}" class="hover:text-base-content transition-colors sm:justify-self-end" data-trans="footer.legal_notice">
                        {{ 'footer.legal_notice'|trans }}
                    </a>
                    <span class="hidden sm:inline text-lg mx-2">•</span>
                    <a href="{{ path('privacy_policy') }}" class="hover:text-base-content transition-colors sm:justify-self-start" data-trans="footer.privacy_policy">
                        {{ 'footer.privacy_policy'|trans }}
                    </a>
                </div>
            </footer>
        </div>
    </div>
    
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            {% if app.flashes('reopen-modal')|length > 0 %}
                contact_modal.showModal();
            {% endif %}
        });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const educationSection = document.getElementById('education');
        const experienceSection = document.getElementById('experience');
        const sectionTitleExperience = document.getElementById('section-title-experience');
        const sectionTitleEducation = document.getElementById('section-title-education');
        const toggleBtnEducation = document.getElementById('toggle-btn-education');
        const toggleBtnExperience = document.getElementById('toggle-btn-experience');

        let showingExperience = true;
        let isTransitioning = false;

        function toggleTitleAndButton(showExperience) {
            if (showExperience) {
                sectionTitleExperience.classList.remove('hidden');
                sectionTitleEducation.classList.add('hidden');
                toggleBtnEducation.classList.remove('hidden');
                toggleBtnExperience.classList.add('hidden');
            } else {
                sectionTitleExperience.classList.add('hidden');
                sectionTitleEducation.classList.remove('hidden');
                toggleBtnEducation.classList.add('hidden');
                toggleBtnExperience.classList.remove('hidden');
            }
        }

        function fadeOutIn(outSection, inSection, showExperienceNext) {
            if (isTransitioning) return;
            isTransitioning = true;
            // Animate out section
            outSection.classList.add('opacity-0', showingExperience ? '-translate-x-8' : 'translate-x-8');
            setTimeout(() => {
                toggleTitleAndButton(showExperienceNext);
            }, 150);
            setTimeout(() => {
                outSection.classList.add('hidden');
                outSection.classList.remove('opacity-0', '-translate-x-8', 'translate-x-8');
                // Animate in section
                inSection.classList.remove('hidden');
                inSection.classList.add(showingExperience ? 'translate-x-8' : '-translate-x-8', 'opacity-0');
                void inSection.offsetWidth;
                inSection.classList.remove('opacity-0', 'translate-x-8', '-translate-x-8');
                setTimeout(() => {
                    isTransitioning = false;
                }, 350);
            }, 300);
        }

        const toggleBtn = document.getElementById('toggle-section-btn');

        toggleBtn.addEventListener('click', function() {
            if (isTransitioning) return;
            if (showingExperience) {
                fadeOutIn(
                    experienceSection,
                    educationSection,
                    false
                );
            } else {
                fadeOutIn(
                    educationSection,
                    experienceSection,
                    true
                );
            }
            showingExperience = !showingExperience;
        });

        // Initial state
        experienceSection.classList.remove('hidden');
        educationSection.classList.add('hidden');
        experienceSection.classList.remove('opacity-0', '-translate-x-8', 'translate-x-8');
        educationSection.classList.remove('opacity-0', '-translate-x-8', 'translate-x-8');
        toggleTitleAndButton(true);
    });
</script>
{% endblock %}
