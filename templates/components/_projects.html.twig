<section id="projects" class="mt-12 lg:mt-16 max-w-3xl mx-auto lg:mx-0">
    <h2 class="text-3xl lg:text-4xl font-bold mb-6 lg:mb-8" data-trans="sections.projects">{{ 'sections.projects'|trans }}</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for project in projects %}
            <div 
                class="group relative pb-1 overflow-hidden rounded-xl shadow-md hover:shadow-lg transition-all duration-500 flex flex-col bg-gradient-to-br from-primary/20 to-base-300/90 border border-base-content/10 cursor-pointer project-card"
                data-modal-id="modal-{{ loop.index }}"
                onclick="document.getElementById('modal-{{ loop.index }}').showModal()"
            >
                <!-- Background Image with overlay -->
                <div class="absolute inset-0 z-0 group-hover:scale-105 transition-all duration-300">
                    <img src="{{ asset('images/' ~ project.image) }}" 
                         alt="{{ project.title|trans }}" 
                         class="w-full h-full object-cover opacity-40 group-hover:opacity-60">
                    <!-- Dark overlay -->
                    <div class="absolute inset-0 bg-base-100/60"></div>
                </div>

                <!-- Content Wrapper -->
                <div class="relative z-10 flex flex-col flex-grow p-4 pt-2">
                    <!-- Project Title -->
                    <div class="text-center w-fit mx-auto mb-1">
                        <h3 class="text-lg font-bold w-fit bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent" data-trans="{{ project.title }}">
                            {{ project.title|trans }}
                        </h3>
                    </div>

                    <!-- Description -->
                    <p class="text-sm leading-tight mb-3 text-justify" data-trans="{{ project.description }}">
                        {{ project.description|trans }}
                    </p>

                    <!-- Spacer to push badges and links to bottom -->
                    <div class="flex-grow"></div>

                    <!-- Technologies -->
                    <div class="flex flex-wrap gap-1 mb-3">
                        {% for tech in project.technologies %}
                            <div class="badge badge-md px-1.5 py-1 bg-{{ tech.color_bg }} text-{{ tech.color_text }} hover:bg-{{ tech.color_hover }} transition-colors border-none">
                                {% if tech.icon is defined %}
                                    <i class="{{ tech.icon }} mr-0.5 text-xs"></i>
                                {% else %}
                                    <img src="{{ asset('images/' ~ tech.image) }}" alt="{{ tech.name }}" class="w-2.5 h-2.5 mr-1">
                                {% endif %}
                                {{ tech.name }}
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Links -->
                    <div class="flex flex-wrap gap-1.5">
                        {% if project.github %}
                            <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" 
                               onclick="event.stopPropagation()"
                               class="btn btn-xs gap-1.5 bg-base-content/20 hover:bg-base-content/30 text-base-content border border-2 border-base-content/20 hover:border-base-content/30 transition-all duration-300">
                                <i class="fa-brands fa-github"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.view_code">{{ 'projects.links.view_code'|trans }}</span>
                            </a>
                        {% endif %}
                        {% if project.website %}
                            <a href="{{ project.website }}" target="_blank" rel="noopener noreferrer" 
                               onclick="event.stopPropagation()"
                               class="btn btn-xs gap-1.5 bg-primary/20 hover:bg-primary/30 text-primary border border-2 border-primary/20 hover:border-primary/30 transition-all duration-300">
                                <i class="fa-solid fa-globe"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.visit_website">{{ 'projects.links.visit_website'|trans }}</span>
                            </a>
                        {% endif %}
                        {% if project.demo %}
                            <a href="{{ project.demo }}" target="_blank" rel="noopener noreferrer" 
                               onclick="event.stopPropagation()"
                               class="btn btn-xs gap-1.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-500 border border-2 border-emerald-500/20 hover:border-emerald-500/30 transition-all duration-300">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.live_demo">{{ 'projects.links.live_demo'|trans }}</span>
                            </a>
                        {% endif %}
                    </div>
                    <!-- Click for more -->
                    <div class="absolute bottom-0.5 right-2 z-10">
                        <span class="text-[10px] text-base-content/60 flex items-center gap-0.5 cursor-pointer select-none pointer-events-none m-0 p-0">
                            <i class="fa-solid fa-ellipsis-h text-[11px]"></i>
                            <span data-trans="common.more">{{ 'common.more'|trans }}</span>
                        </span>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Modals outside the grid for proper stacking #}
    {% for project in projects %}
    <dialog id="modal-{{ loop.index }}" class="modal modal-center">
        <div class="modal-box w-11/12 max-w-7xl bg-base-200/95 border border-base-content/10 relative p-0 overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Decorative background gradient -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 pointer-events-none"></div>
            
            <!-- Close Button -->
            <form method="dialog">
                <button class="btn btn-sm btn-circle absolute right-4 top-4 z-50 bg-base-100/80 hover:bg-base-100 transition-all duration-300 group shadow-sm border border-base-content/10">
                    <i class="fa-solid fa-xmark text-base-content/70 group-hover:text-base-content transition-colors"></i>
                </button>
            </form>

            <!-- Mobile-only Sticky Header for Title -->
            <div class="sticky top-0 z-40 bg-base-200/95 border-b border-base-content/10 px-6 py-4 md:hidden shrink-0 pr-16">
                <h3 class="text-2xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent inline-block" data-trans="{{ project.title }}">
                    {{ project.title|trans }}
                </h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-5 flex-grow overflow-y-auto md:overflow-hidden min-h-0">
                <!-- Column 1: Visuals & Info -->
                <div class="md:col-span-2 p-6 pt-12 md:pt-6 flex flex-col bg-base-300/30 md:overflow-y-auto items-center text-center">
                    
                    <div class="flex-grow flex flex-col justify-center gap-6 w-full">
                        <!-- Title (Desktop Only) -->
                        <div class="w-full hidden md:block">
                            <h3 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent inline-block" data-trans="{{ project.title }}">
                                {{ project.title|trans }}
                            </h3>
                        </div>

                        <!-- Image -->
                        <div class="relative rounded-xl overflow-hidden shadow-lg group shrink-0 w-full max-w-sm mx-auto">
                            <img src="{{ asset('images/' ~ project.image) }}" alt="{{ project.title|trans }}" class="w-full h-auto object-cover">
                        </div>
                        
                        <!-- Technologies -->
                        <div class="w-full">
                            <div class="flex flex-wrap gap-1 mb-2 justify-center">
                                {% for tech in project.technologies %}
                                    <div class="badge badge-md px-1.5 py-1 bg-{{ tech.color_bg }} text-{{ tech.color_text }} hover:bg-{{ tech.color_hover }} transition-colors border-none">
                                        {% if tech.icon is defined %}
                                            <i class="{{ tech.icon }} mr-0.5 text-xs"></i>
                                        {% else %}
                                            <img src="{{ asset('images/' ~ tech.image) }}" alt="{{ tech.name }}" class="w-2.5 h-2.5 mr-1">
                                        {% endif %}
                                        {{ tech.name }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <!-- Links -->
                    {% if project.github or project.website or project.demo %}
                    <div class="flex flex-wrap gap-1.5 pt-4 mt-6 border-t border-base-content/10 w-full justify-center shrink-0">
                        {% if project.github %}
                            <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" 
                               class="btn btn-xs gap-1.5 bg-base-content/20 hover:bg-base-content/30 text-base-content border border-2 border-base-content/20 hover:border-base-content/30 transition-all duration-300">
                                <i class="fa-brands fa-github"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.view_code">{{ 'projects.links.view_code'|trans }}</span>
                            </a>
                        {% endif %}
                        {% if project.website %}
                            <a href="{{ project.website }}" target="_blank" rel="noopener noreferrer" 
                               class="btn btn-xs gap-1.5 bg-primary/20 hover:bg-primary/30 text-primary border border-2 border-primary/20 hover:border-primary/30 transition-all duration-300">
                                <i class="fa-solid fa-globe"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.visit_website">{{ 'projects.links.visit_website'|trans }}</span>
                            </a>
                        {% endif %}
                        {% if project.demo %}
                            <a href="{{ project.demo }}" target="_blank" rel="noopener noreferrer" 
                               class="btn btn-xs gap-1.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-500 border border-2 border-emerald-500/20 hover:border-emerald-500/30 transition-all duration-300">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span class="text-[10px] font-bold" data-trans="projects.links.live_demo">{{ 'projects.links.live_demo'|trans }}</span>
                            </a>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
                
                <!-- Column 2: Description -->
                <div class="md:col-span-3 p-6 md:p-8 md:overflow-y-auto relative">
                    {% set details = project.details_data|default(null) %}
                    
                    {% if details %}
                        <div class="space-y-4 lg:space-y-6">
                            {% if details.intro %}
                                <p class="text-sm md:text-base leading-relaxed text-base-content/90 text-justify" data-trans="{{ details.intro }}">
                                    {{ details.intro|trans }}
                                </p>
                            {% endif %}

                            <div class="grid grid-cols-1 gap-4 lg:gap-6">
                                {% for section in details.sections %}
                                    <div class="bg-base-300/30 rounded-xl p-2 px-3 md:p-3 md:px-4 border border-base-content/10 shadow-sm transition-all duration-300 hover:bg-base-300/40">
                                        <h4 class="text-base md:text-lg font-bold mb-4 text-primary flex items-center gap-2">
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
                                            <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent" data-trans="{{ section.title }}">{{ section.title|trans }}</span>
                                        </h4>
                                        
                                        {% if section.type == 'list' %}
                                            <ul class="space-y-2.5">
                                                {% for item in section.items %}
                                                    <li class="flex items-start gap-3 text-sm md:text-base text-base-content/80">
                                                        <i class="fa-solid fa-check text-[10px] mt-1.5 text-secondary shrink-0"></i>
                                                        <span class="leading-snug" data-trans="{{ item }}">{{ item|trans }}</span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% elseif section.type == 'text' %}
                                            <p class="text-sm md:text-base leading-relaxed text-base-content/80 text-justify" data-trans="{{ section.content }}" data-trans-raw>
                                                {{ section.content|trans|raw }}
                                            </p>
                                        {% elseif section.type == 'keyvalue' %}
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                {% for item in section.items %}
                                                    <div class="text-sm md:text-base p-2 rounded-lg bg-base-100/30 border border-base-content/5">
                                                        <span class="font-bold text-secondary block text-xs uppercase tracking-wider mb-0.5" data-trans="{{ item.key }}">{{ item.key|trans }}</span>
                                                        <span class="text-base-content/90 font-medium" data-trans="{{ item.value }}">{{ item.value|trans }}</span>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>

                            {% if details.conclusion %}
                                <p class="text-sm md:text-base leading-relaxed text-base-content/90 pt-4 border-t border-base-content/10 text-justify italic" data-trans="{{ details.conclusion }}">
                                    {{ details.conclusion|trans }}
                                </p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="prose prose-base max-w-none text-base-content/80 leading-relaxed space-y-4 text-justify" data-trans="{{ project.details }}" data-trans-raw>
                            {{ project.details|trans|raw }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop bg-base-200/50">
            <button>close</button>
        </form>
    </dialog>
    {% endfor %}
</section>